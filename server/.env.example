# TripCraft Server Configuration
PORT=5001
NODE_ENV=development

# PostgreSQL Configuration
# You can provide a complete connection string (Neon, Supabase, Railway, Render, or local):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripcraft

# OR discrete PostgreSQL parameters:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=tripcraft

# SSL Mode (Set to true when using Neon / Supabase / AWS RDS / Render in production)
PGSSL=false
